{
  "name": "knowledge-base-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first knowledge base desktop app.",
  "main": "dist-electron/main.js",
  "author": "",
  "license": "MIT",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev --hostname 127.0.0.1 --port 3000",
    "build:web": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run typecheck:electron && npm run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:electron": "tsc --project electron/tsconfig.json",
    "build": "npm run build:web && npm run build:electron",
    "start": "electron .",
    "package": "npm run build && electron-builder",
    "typecheck:electron": "tsc --project electron/tsconfig.json --noEmit",
    "test": "npm run test:unit",
    "test:desktop": "playwright test --config playwright.desktop.config.ts",
    "test:unit": "tsc --project tsconfig.tests.json && node --experimental-test-isolation=none --test .cache/test-dist/tests/domain/knowledge.test.js",
    "test:browser": "playwright test",
    "preview": "node scripts/preview.mjs",
    "package:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0",
    "lucide-react": "1.57.0",
    "tw-animate-css": "1.4.0",
    "radix-ui": "1.8.1",
    "class-variance-authority": "0.7.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "@playwright/test": "1.64.0"
  },
  "build": {
    "appId": "com.zhiyu.knowledgebase",
    "productName": "Zhiyu",
    "asar": true,
    "files": [
      "dist-electron/**/*",
      "out/**/*",
      "package.json",
      "!node_modules{,/**/*}"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    }
  }
}

{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": ".",
    "outDir": ".cache/test-dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "tests/domain/**/*.ts",
    "src/features/knowledge/model.ts",
    "src/features/knowledge/repository.ts",
    "src/features/knowledge/seed.ts"
  ]
}
